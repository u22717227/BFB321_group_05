# Eyabantu Taxi Program - Environment Variables
# Copy this file to .env and fill in your values

# development, testing or production (production turns debug off)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# MySQL connection (your local MySQL login, usually root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=eyabantu
